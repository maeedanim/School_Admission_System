# PostgreSQL
POSTGRES_DB=school_admission
POSTGRES_USER=school_app
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
POSTGRES_PORT=5432

# JWT
# Must be Base64 encoded and decode to at least 32 bytes.
JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_SECRET
JWT_ISSUER=SchoolAdmission.API
JWT_AUDIENCE=SchoolAdmission.Client

# Initial administrator for a fresh Docker database
ADMIN_BOOTSTRAP_FULL_NAME=System Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Admission hold configuration
HOLD_DURATION_SECONDS=600

# Frontend
FRONTEND_ORIGIN=http://localhost:5173
